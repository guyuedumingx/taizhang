# 示例环境配置文件
# 复制此文件为 .env 并根据实际情况修改配置

# 项目名称
PROJECT_NAME=台账管理系统
API_V1_STR=/api/v1

# JWT 配置
SECRET_KEY=your_32_character_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=4320

# 数据库配置
# 如果使用 SQLite:
DATABASE_TYPE=sqlite
# 如果使用 Oracle（需要安装 cx_Oracle）:
# DATABASE_TYPE=oracle
# ORACLE_USER=your_username
# ORACLE_PASSWORD=your_password
# ORACLE_HOST=oracle_server_ip
# ORACLE_PORT=1521
# ORACLE_SERVICE=service_name

# 连接池配置（Oracle 适用）
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# CORS 配置
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# 首次用户配置
FIRST_SUPERUSER=admin
FIRST_SUPERUSER_PASSWORD=initial_password

# 迁移相关配置
# SQLite 数据库文件路径（默认放在 backend 目录下）
SQLITE_DB_PATH=taizhang.db

# Oracle → SQLite 迁移：源 Oracle 配置
# ORACLE_DSN 格式示例
# ORACLE_DSN=192.168.1.100:1521/orcl

# Oracle → Oracle 迁移：源库配置
SOURCE_ORACLE_USER=source_user
SOURCE_ORACLE_PASSWORD=source_password
SOURCE_ORACLE_DSN=192.168.1.100:1521/source_orcl

# Oracle → Oracle 迁移：目标库配置
TARGET_ORACLE_USER=target_user
TARGET_ORACLE_PASSWORD=target_password
TARGET_ORACLE_DSN=192.168.2.100:1521/target_orcl

# Oracle → Oracle 迁移：批量大小（默认 500）
BATCH_SIZE=500

# Oracle → Oracle 迁移：是否在迁移前按反向依赖顺序清空目标库（默认 true）
CLEAN_TARGET=true