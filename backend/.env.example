# 后端开发/生产环境配置示例
# 用法：cp .env.example .env  （或 backend/.env.example backend/.env）
#       然后根据需要修改；.env 已在根 .gitignore 中，不会被提交

# JWT 签名密钥；生产环境必须覆盖
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-your-production-secret

# Token 有效期（分钟）默认 11520 = 8 天
ACCESS_TOKEN_EXPIRE_MINUTES=11520
